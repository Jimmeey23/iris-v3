# Copy to .env (never commit .env).

# Required — Neon Postgres (pooled connection string, sslmode=require)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional — training sandbox for admins: a SEPARATE database with the same schema
# (never the real one). Leave empty to hide the sandbox. Seed it from the app:
# account menu > Training sandbox > Reset mock data.
SANDBOX_DATABASE_URL=postgresql://USER:PASSWORD@HOST/iris_sandbox?sslmode=require

# Session cookie + deep links in email. The origin users sign in on.
NEXT_PUBLIC_APP_URL=https://iris.example.com

# 32+ random bytes (e.g. `openssl rand -base64 32`). Encrypts integration credentials saved
# in Settings. Changing it makes previously saved credentials unreadable.
INTEGRATION_ENCRYPTION_KEY=

# Background work (outbox drain, SLA/escalation sweep): /api/cron/outbox and
# /api/cron/sla reject every call until this is set. Sent by Vercel Cron
# automatically; for curl/system crontab pass `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Mailtrap (notification email via the outbox). The API key path is preferred;
# SMTP is the fallback. With neither set, email is logged as 'skipped'.
MAILTRAP_API_KEY=
MAILTRAP_FROM_EMAIL="IRIS <iris@example.com>"
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=

# Set to 1 to log notification email as dry_run instead of queueing it.
NOTIFY_DRY_RUN=

# Momence webhooks: shared secret sent as the x-iris-webhook-secret header
MOMENCE_WEBHOOK_SECRET=

# Optional integrations (server-side only; never prefix secrets with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Momence (Mumbai account; the *_BLR set is the Bengaluru account). Optional API base override.
MOMENCE_API_URL=
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
MOMENCE_CLIENT_ID_BLR=
MOMENCE_CLIENT_SECRET_BLR=
MOMENCE_USERNAME_BLR=
MOMENCE_PASSWORD_BLR=
# Optional model overrides (defaults are built in)
ANTHROPIC_MODEL=
IRIS_INTAKE_MODEL=
IRIS_ENRICH_MODEL=
# Where the in-app feedback button sends developer copies
FEEDBACK_DEVELOPER_EMAIL=dev@example.com

# Google sign-in (OAuth web client). Redirect URI: <app origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may self-provision with Google (v2 rules). Others need an admin-created account.
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=you@example.com

# Inbound email → ticket (Mailtrap Inbound). See docs/superpowers/specs/2026-11-19-email-to-ticket-design.md
MAILTRAP_API_URL=
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_INBOUND_INBOX_ID=123456
MAILTRAP_INBOUND_SECRET=your-webhook-signing-secret
# Comma-separated; senders on these domains are treated as staff forwards
STAFF_EMAIL_DOMAINS=example.com
# Private Vercel Blob store for ticket attachments
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# respond.io (WhatsApp nudges to staff)
RESPOND_API_KEY=
RESPOND_CHANNEL_ID=
RESPOND_TEMPLATE_LANGUAGE=en
