# Copy to .env (never commit .env).

# Required — Neon Postgres (pooled connection string, sslmode=require)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Session cookie + deep links in email. The origin users sign in on.
NEXT_PUBLIC_APP_URL=https://iris.example.com

# Background work (outbox drain, SLA/escalation sweep): /api/cron/outbox and
# /api/cron/sla reject every call until this is set. Sent by Vercel Cron
# automatically; for curl/system crontab pass `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Mailtrap (notification email via the outbox). The API key path is preferred;
# SMTP is the fallback. With neither set, email is logged as 'skipped'.
MAILTRAP_API_KEY=
MAILTRAP_FROM_EMAIL="IRIS <iris@example.com>"
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=

# Set to 1 to log notification email as dry_run instead of queueing it.
NOTIFY_DRY_RUN=

# Momence webhooks: shared secret sent as the x-iris-webhook-secret header
MOMENCE_WEBHOOK_SECRET=

# Optional integrations (server-side only; never prefix secrets with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
